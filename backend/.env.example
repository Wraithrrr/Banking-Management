# ── Production (set in Railway → Variables) ──────────────────────────────────
# Database — Railway provides DATABASE_URL automatically if you add a Postgres plugin
# Alternatively, use Supabase and fill in the values below
DB_HOST=your-db-host.railway.internal
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your-db-password
DB_NAME=smartes_banking

# JWT — generate a strong secret: openssl rand -hex 64
JWT_SECRET=change-this-to-a-very-long-random-string-in-production

# CORS — set to your Vercel frontend URL (comma-separate for multiple origins)
# CORS_ORIGIN=https://your-app.vercel.app,http://localhost:3000
CORS_ORIGIN=https://your-app.vercel.app

# App
PORT=3001
NODE_ENV=production

# ── Local development ────────────────────────────────────────────────────────
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# DB_NAME=smartes_banking
# JWT_SECRET=local-dev-secret
# CORS_ORIGIN=http://localhost:3000
# PORT=3001
# NODE_ENV=development
